# Application
NODE_ENV=development
PORT=3000
API_PREFIX=frequencia/api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frequencia
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=frequencia

# Keycloak
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080/auth
KEYCLOAK_REALM=Local
KEYCLOAK_CLIENT_ID=frequencia-back
KEYCLOAK_JWKS_CACHE_MAX_AGE=600000
KEYCLOAK_JWKS_TIMEOUT=5000

# Swagger/OpenAPI
SWAGGER_TITLE=P07 - Controle de Frequência
SWAGGER_DESCRIPTION=API de Controle de Frequência Acadêmica
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api/docs

# Integrações (futuro)
UFPE_API_URL=https://api.ufpe.br
UFPE_API_TOKEN=seu_token_aqui
