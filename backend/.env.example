# Application
NODE_ENV=development
PORT=3000
API_PREFIX=frequencia/api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/frequencia
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=frequencia

# Keycloak
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=p07-frequencia
KEYCLOAK_CLIENT_ID=p07-back
KEYCLOAK_JWKS_CACHE_MAX_AGE=600000
KEYCLOAK_JWKS_TIMEOUT=5000

# Swagger/OpenAPI
SWAGGER_TITLE=P07 - Controle de Frequência
SWAGGER_DESCRIPTION=API de Controle de Frequência Acadêmica
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api/docs

# Integrações (futuro)
UFPE_API_URL=https://api.ufpe.br
UFPE_API_TOKEN=seu_token_aqui

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Attendance token settings
ATTENDANCE_TOKEN_SECRET=local-development-secret-change-this-to-at-least-32-characters
ATTENDANCE_TOKEN_TTL_MINUTES=15
