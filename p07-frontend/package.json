{
  "name": "p07-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/v2 tests/integration",
    "test:v1": "vitest run tests/v1-llm",
    "test:v2": "vitest run tests/v2",
    "test:coverage:v1": "vitest run tests/v1-llm --coverage --coverage.reportsDirectory=coverage/v1",
    "test:coverage:v2": "vitest run tests/v2 --coverage --coverage.reportsDirectory=coverage/v2",
    "check": "tsc --noEmit -p tsconfig.test.json"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "lucide-react": "^0.563.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "3.2.4"
  },
  "private": true
}
