# Modo padrão: dados fictícios e armazenamento no navegador.
VITE_APP_MODE=demo
VITE_BASE_URL=/

# Use VITE_APP_MODE=keycloak para autenticar pelo Keycloak e usar a API de turmas/chamadas.
VITE_API_URL=http://localhost:3000/frequencia/api
VITE_KEYCLOAK_JSON={"realm":"p07-frequencia","auth-server-url":"http://localhost:8080/","resource":"p07-front","public-client":true}

# Ajustar aos nomes de papéis acordados com o backend.
VITE_ROLE_ADMIN=p07-admin
VITE_ROLE_PROFESSOR=p07-professor
VITE_ROLE_ALUNO=p07-student
